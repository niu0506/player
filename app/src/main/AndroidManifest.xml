<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 前台服务：后台播放需要常驻运行 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <!-- API 34+ 要求前台服务指明媒体播放类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- API 33+ 通知权限（用于前台服务通知/锁屏控制） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 读取本地视频（API 33+） -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        tools:ignore="PhotoAndVideoPolicy" />
    <!-- API 34+ 的部分媒体访问：用户选择「仅访问选中的照片/视频」时授予该权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- 读取本地音频（API 33+） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- 老版本（API <= 32）读取本地媒体 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 仅 Android 9 及以下：DownloadManager 写公共 Download 需要此权限（API 29+ 走 MediaStore，无需） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- App 内更新：Android 8+ 调起系统安装器需要（用户需在设置中授予「安装未知应用」） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <!-- App 内更新：检查版本 / 下载 APK 需要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PlayerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Player"
        tools:targetApi="35">

        <!-- 主界面；开启画中画并自行处理配置变化（避免旋转时重建导致界面抖动） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台播放服务；通过 MediaSessionService action 暴露给控制器 -->
        <service
            android:name=".playback.PlayerService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 暴露下载好的更新 APK 给系统安装器（FileProvider） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.file-provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
