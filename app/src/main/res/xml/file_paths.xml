<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 路径声明：应用专属外部目录下的 Download 子目录（更新包下载位置） -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path
        name="update_downloads"
        path="Download/" />
    <!-- 公共 Download 目录：更新包改存于此，供系统安装器访问 -->
    <external-path
        name="public_downloads"
        path="Download/" />
</paths>
