<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的云备份与设备迁移规则：
     把「播放列表/进度」所在的 SharedPreferences(player.xml) 排除在备份之外，
     这样用户卸载重装后不会恢复旧播放列表。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="player.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="player.xml" />
    </device-transfer>
</data-extraction-rules>