<?xml version="1.0" encoding="utf-8"?>

<!--
  播放器控制栏布局（替换 Media3 默认控制视图）。
  使用 exo_* 的文档化视图 ID，供 PlayerView 自动注入与绑定；额外加入音轨 / 字幕 / 倍速入口。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

  <View android:id="@id/exo_controls_background"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@color/player_control_overlay"/>

  <!-- 左上角返回键：仅全屏时由 FullscreenPipHelper 置为可见，随控制栏一起显隐 -->
  <ImageButton android:id="@+id/btn_fullscreen_back"
      style="@style/PlayerControls.Button.Back"
      android:layout_gravity="top|start"
      android:contentDescription="@string/player_control_back"
      android:visibility="gone"/>

  <FrameLayout android:id="@id/exo_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="@dimen/player_control_bottom_bar_height"
      android:layout_marginTop="@dimen/player_control_bottom_bar_top_margin"
      android:layout_gravity="bottom"
      android:background="@color/player_control_bar">

    <LinearLayout android:id="@id/exo_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/player_control_time_padding"
        android:paddingEnd="@dimen/player_control_time_padding"
        android:layout_gravity="center_vertical|start">

      <!-- 当前时间 / 总时长 -->
      <TextView android:id="@id/exo_position"
          style="@style/PlayerControls.TimeText.Position"/>

      <TextView
          style="@style/PlayerControls.TimeText.Separator"/>

      <TextView android:id="@id/exo_duration"
          style="@style/PlayerControls.TimeText.Duration"/>

    </LinearLayout>

    <LinearLayout android:id="@id/exo_basic_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end">

      <!-- 应用自定义入口：音轨 / 字幕 / 倍速 -->
      <TextView android:id="@+id/btn_audio"
          style="@style/PlayerControls.TextButton"
          android:text="@string/track_audio"/>

      <TextView android:id="@+id/btn_subtitle"
          style="@style/PlayerControls.TextButton"
          android:text="@string/track_subtitle"/>

      <!-- 随机播放 -->
      <ImageButton android:id="@id/exo_shuffle"
          style="@style/PlayerControls.Button.Shuffle"
          android:contentDescription="@string/player_control_shuffle"/>

      <ImageButton android:id="@id/exo_repeat_toggle"
          style="@style/PlayerControls.Button.Repeat"
          android:contentDescription="@string/player_control_repeat"/>

      <TextView android:id="@+id/btn_speed"
          style="@style/PlayerControls.TextButton"
          android:text="@string/speed_default_label"
          android:textStyle="bold"/>

      <ImageButton android:id="@id/exo_fullscreen"
          style="@style/PlayerControls.Button.Fullscreen"
          android:contentDescription="@string/player_control_fullscreen"/>

      <ImageButton android:id="@id/exo_overflow_show"
          style="@style/PlayerControls.Button.OverflowShow"
          android:contentDescription="@string/player_control_more"/>

    </LinearLayout>

    <HorizontalScrollView android:id="@id/exo_extra_controls_scroll_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:visibility="invisible">

      <LinearLayout android:id="@id/exo_extra_controls"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content">

        <ImageButton android:id="@id/exo_overflow_hide"
            style="@style/PlayerControls.Button.OverflowHide"
            android:contentDescription="@string/player_control_less"/>

      </LinearLayout>

    </HorizontalScrollView>

  </FrameLayout>

  <View android:id="@id/exo_progress_placeholder"
      android:layout_width="match_parent"
      android:layout_height="@dimen/player_control_progress_layout_height"
      android:layout_gravity="bottom"
      android:layout_marginBottom="@dimen/player_control_progress_margin_bottom"/>

  <LinearLayout android:id="@id/exo_minimal_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginBottom="@dimen/player_control_minimal_margin_bottom"
      android:orientation="horizontal"
      android:gravity="center_vertical">

    <ImageButton android:id="@id/exo_minimal_fullscreen"
        style="@style/PlayerControls.Button.Fullscreen"
        android:contentDescription="@string/player_control_fullscreen"/>

  </LinearLayout>

  <!-- 居中控制：上一项 / 快退 / 播放暂停 / 快进 / 下一项 -->
  <LinearLayout
      android:id="@id/exo_center_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@android:color/transparent"
      android:gravity="center"
      android:padding="@dimen/player_control_center_padding"
      android:clipToPadding="false">

    <ImageButton android:id="@id/exo_prev"
        style="@style/PlayerControls.Button.Previous"
        android:contentDescription="@string/player_control_previous"/>

    <Button android:id="@id/exo_rew_with_amount"
        android:singleLine="false"
        style="@style/PlayerControls.Button.Seek"/>

    <ImageButton android:id="@id/exo_play_pause"
        style="@style/PlayerControls.Button.PlayPause"
        android:contentDescription="@string/player_control_play_pause"/>

    <Button android:id="@id/exo_ffwd_with_amount"
        android:singleLine="false"
        style="@style/PlayerControls.Button.FastForward"/>

    <ImageButton android:id="@id/exo_next"
        style="@style/PlayerControls.Button.Next"
        android:contentDescription="@string/player_control_next"/>

  </LinearLayout>

</merge>
