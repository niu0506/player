<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 播放器卡片（全屏 / 小窗时由 FullscreenPipHelper 动态调整圆角与边距） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/player_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/bg_dark"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <!-- 使用应用自有的控制栏布局与图标，避免绑定 Media3 私有资源。
             TextureView 换取圆角裁剪 / PiP 过渡；HDR 或功耗优先时改为 surface_view，并同步去掉卡片圆角。 -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="true"
            app:show_timeout="3000"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:show_buffering="when_playing"
            app:controller_layout_id="@layout/custom_player_control_view"
            app:play_icon="@drawable/player_control_play"
            app:pause_icon="@drawable/player_control_pause"
            app:previous_icon="@drawable/player_control_previous"
            app:next_icon="@drawable/player_control_next"
            app:repeat_off_icon="@drawable/player_control_repeat_off"
            app:repeat_one_icon="@drawable/player_control_repeat_one"
            app:repeat_all_icon="@drawable/player_control_repeat_all"
            app:shuffle_off_icon="@drawable/player_control_shuffle_off"
            app:shuffle_on_icon="@drawable/player_control_shuffle_on"
            app:fullscreen_enter_icon="@drawable/player_control_fullscreen_enter"
            app:fullscreen_exit_icon="@drawable/player_control_fullscreen_exit" />

        <!-- 全屏顶部信息：文件名 / 系统时间 / 电量（随控制栏自动显隐） -->
        <LinearLayout
            android:id="@+id/fullscreen_info_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/fullscreen_info_start_padding"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                style="@style/FullscreenInfoText"
                android:id="@+id/tv_fullscreen_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                style="@style/FullscreenInfoText"
                android:id="@+id/tv_fullscreen_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />

            <TextView
                style="@style/FullscreenInfoText"
                android:id="@+id/tv_fullscreen_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp" />

        </LinearLayout>

        <!-- 手势反馈浮层（快进/快退、亮度、音量） -->
        <TextView
            android:id="@+id/gesture_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_gesture_overlay"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 顶部工具栏：标题与数量一行，操作按钮另起一行等宽平分。
         分两行后窄屏 / 分屏 / 小窗下按钮文字都能完整显示，不再互相挤压 -->
    <LinearLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <!-- 第一行：播放列表标题 + 数量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/playlist_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/bg_pill_button"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 第二行：小窗 / 扫描 / 更多，等宽平分 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp">

            <Button
                android:id="@+id/btn_pip"
                style="@style/ToolbarActionButton"
                android:text="@string/pip" />

            <Button
                android:id="@+id/btn_scan"
                style="@style/ToolbarActionButton"
                android:layout_marginStart="8dp"
                android:text="@string/scan_local" />

            <Button
                android:id="@+id/btn_more"
                style="@style/ToolbarActionButton"
                android:layout_marginStart="8dp"
                android:text="@string/more" />
        </LinearLayout>
    </LinearLayout>

    <!-- 播放列表容器（空态与列表叠加） -->
    <FrameLayout
        android:id="@+id/playlist_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_playlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/list_empty_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 静默扫描发现新增时的轻提示：不弹 Toast，只在列表顶部短暂显示 -->
        <TextView
            android:id="@+id/tv_scan_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_pill_button"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
