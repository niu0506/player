<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- 播放器卡片（全屏 / 小窗时由 FullscreenPipHelper 动态调整圆角与边距） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/player_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/surface_1"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <!-- 使用应用自有的控制栏布局与图标，避免绑定 Media3 私有资源 -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="true"
            app:show_timeout="3000"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:show_buffering="when_playing"
            app:controller_layout_id="@layout/custom_player_control_view"
            app:play_icon="@drawable/player_control_play"
            app:pause_icon="@drawable/player_control_pause"
            app:previous_icon="@drawable/player_control_previous"
            app:next_icon="@drawable/player_control_next"
            app:rewind_icon="@drawable/player_control_rewind"
            app:fastforward_icon="@drawable/player_control_fastforward"
            app:repeat_off_icon="@drawable/player_control_repeat_off"
            app:repeat_one_icon="@drawable/player_control_repeat_one"
            app:repeat_all_icon="@drawable/player_control_repeat_all"
            app:shuffle_off_icon="@drawable/player_control_shuffle_off"
            app:shuffle_on_icon="@drawable/player_control_shuffle_on"
            app:fullscreen_enter_icon="@drawable/player_control_fullscreen_enter"
            app:fullscreen_exit_icon="@drawable/player_control_fullscreen_exit" />

        <!-- 手势反馈浮层（快进/快退、亮度、音量） -->
        <TextView
            android:id="@+id/gesture_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_gesture_overlay"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 顶部工具栏：标题、数量、小窗、扫描、更多（检查更新） -->
    <LinearLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_playlist_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/playlist_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_pill_button"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_pip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_pill_button"
            android:drawableStart="@drawable/ic_pip"
            android:drawablePadding="5dp"
            android:drawableTint="@color/text_secondary"
            android:text="@string/pip"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_pill_button"
            android:drawableStart="@drawable/ic_scan"
            android:drawablePadding="5dp"
            android:drawableTint="@color/text_secondary"
            android:text="@string/scan_local"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_button"
            android:src="@drawable/ic_more"
            android:scaleType="centerInside"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/check_update" />
    </LinearLayout>

    <!-- 播放列表容器（空态与列表叠加） -->
    <FrameLayout
        android:id="@+id/playlist_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_playlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="@string/list_empty_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
