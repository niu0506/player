<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面布局：竖屏结构 = 顶部播放器卡片 + 工具栏 + 底部播放列表 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- 播放器卡片容器：承载视频画面与手势提示 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/player_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/surface_1"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <!-- ExoPlayer 播放视图；使用自定义控制栏，3 秒后自动隐藏，TextureView 渲染 -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="true"
            app:show_timeout="3000"
            app:resize_mode="fit"
            app:surface_type="texture_view"
            app:show_buffering="when_playing"
            app:controller_layout_id="@layout/custom_player_control_view" />

        <!-- 全屏模式下的左上角返回按钮，默认隐藏 -->
        <ImageButton
            android:id="@+id/btn_back_fs"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF"
            android:background="@drawable/bg_icon_circle"
            android:visibility="gone"
            android:contentDescription="退出全屏" />

        <!-- 手势反馈浮层：滑动调节亮度/音量/进度、双击快进快退时的提示 -->
        <TextView
            android:id="@+id/gesture_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_gesture_overlay"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 工具栏：标题 + 数量 + 小窗 + 扫描按钮 -->
    <LinearLayout
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_playlist_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="播放列表"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_pill_button"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_pip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_pill_button"
            android:drawableStart="@drawable/ic_pip"
            android:drawablePadding="5dp"
            android:drawableTint="@color/text_secondary"
            android:text="@string/pip"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_pill_button"
            android:drawableStart="@drawable/ic_scan"
            android:drawablePadding="5dp"
            android:drawableTint="@color/text_secondary"
            android:text="@string/scan_local"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- 溢出菜单（⋮）：检查更新等更多操作 -->
        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_button"
            android:src="@drawable/ic_more"
            android:scaleType="centerInside"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/check_update" />
    </LinearLayout>

    <!-- 播放列表容器：高度占屏约 3/5；全屏/PiP 时整体隐藏 -->
    <FrameLayout
        android:id="@+id/playlist_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 播放列表本身 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_playlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- 空列表提示，默认隐藏 -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:text="播放列表还是空的\n点击上方「扫描」导入本地视频和音频"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
