<resources>
    <!-- 应用主题：基于 Material3 深色无标题栏 -->
    <style name="Theme.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FF17102A</item>
        <item name="colorSecondary">@color/accent_deep</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_1</item>
        <!-- 系统栏颜色由 enableEdgeToEdge 统一管理，避免 Android 15+ 上的弃用属性 -->
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>
</resources>
