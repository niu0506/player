<resources>
    <!-- 控制栏自有尺寸 / 颜色 / 样式：仅依赖 Media3 文档化的控制视图 ID 与图标属性 -->
    <dimen name="player_control_bottom_bar_height">60dp</dimen>
    <dimen name="player_control_bottom_bar_top_margin">10dp</dimen>
    <dimen name="player_control_time_padding">10dp</dimen>
    <dimen name="player_control_center_padding">24dp</dimen>
    <dimen name="player_control_progress_layout_height">48dp</dimen>
    <dimen name="player_control_progress_margin_bottom">52dp</dimen>
    <dimen name="player_control_minimal_margin_bottom">4dp</dimen>
    <dimen name="player_control_icon_size">52dp</dimen>
    <dimen name="player_control_small_icon_size">48dp</dimen>
    <dimen name="player_control_icon_margin">2dp</dimen>
    <dimen name="player_control_icon_padding">10dp</dimen>
    <dimen name="player_control_small_icon_padding">12dp</dimen>
    <dimen name="player_control_time_text_size">14sp</dimen>
    <dimen name="player_control_seek_text_size">9sp</dimen>
    <dimen name="player_control_seek_padding_bottom">4dp</dimen>

    <color name="player_control_overlay">#99000000</color>
    <color name="player_control_bar">#CC000000</color>
    <color name="player_control_text">#FFFFFFFF</color>
    <color name="player_control_muted_text">#B3FFFFFF</color>

    <!-- 点号命名的隐式父样式：PlayerControls.* 均继承它，不能删除 -->
    <style name="PlayerControls" />
    <style name="PlayerControls.Button">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_marginLeft">@dimen/player_control_icon_margin</item>
        <item name="android:layout_marginRight">@dimen/player_control_icon_margin</item>
        <item name="android:contentDescription">@string/player_control_action</item>
    </style>
    <style name="PlayerControls.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/player_control_text</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="PlayerControls.Button.Bottom" parent="PlayerControls.Button">
        <item name="android:layout_width">@dimen/player_control_small_icon_size</item>
        <item name="android:layout_height">@dimen/player_control_small_icon_size</item>
        <item name="android:padding">@dimen/player_control_small_icon_padding</item>
    </style>
    <style name="PlayerControls.Button.Shuffle" parent="PlayerControls.Button.Bottom">
        <item name="android:src">@drawable/player_control_shuffle_off</item>
        <item name="android:contentDescription">@string/player_control_shuffle</item>
    </style>
    <style name="PlayerControls.Button.Repeat" parent="PlayerControls.Button.Bottom">
        <item name="android:src">@drawable/player_control_repeat_off</item>
        <item name="android:contentDescription">@string/player_control_repeat</item>
    </style>
    <style name="PlayerControls.Button.Fullscreen" parent="PlayerControls.Button.Bottom">
        <item name="android:src">@drawable/player_control_fullscreen_enter</item>
        <item name="android:contentDescription">@string/player_control_fullscreen</item>
    </style>
    <style name="PlayerControls.Button.OverflowShow" parent="PlayerControls.Button.Bottom">
        <item name="android:src">@drawable/player_control_overflow_show</item>
        <item name="android:contentDescription">@string/player_control_more</item>
    </style>
    <style name="PlayerControls.Button.OverflowHide" parent="PlayerControls.Button.Bottom">
        <item name="android:src">@drawable/player_control_overflow_hide</item>
        <item name="android:contentDescription">@string/player_control_less</item>
    </style>
    <!-- 仅全屏时显示，位于左上角，随控制栏一起显隐 -->
    <style name="PlayerControls.Button.Back" parent="PlayerControls.Button.Bottom">
        <item name="android:src">@drawable/ic_back</item>
        <item name="android:contentDescription">@string/player_control_back</item>
    </style>
    <style name="PlayerControls.Button.Center" parent="PlayerControls.Button">
        <item name="android:layout_width">@dimen/player_control_icon_size</item>
        <item name="android:layout_height">@dimen/player_control_icon_size</item>
        <item name="android:padding">@dimen/player_control_icon_padding</item>
    </style>
    <style name="PlayerControls.Button.Previous" parent="PlayerControls.Button.Center">
        <item name="android:src">@drawable/player_control_previous</item>
        <item name="android:contentDescription">@string/player_control_previous</item>
    </style>
    <style name="PlayerControls.Button.Next" parent="PlayerControls.Button.Center">
        <item name="android:src">@drawable/player_control_next</item>
        <item name="android:contentDescription">@string/player_control_next</item>
    </style>
    <style name="PlayerControls.Button.PlayPause" parent="PlayerControls.Button.Center">
        <item name="android:src">@drawable/player_control_play</item>
        <item name="android:contentDescription">@string/player_control_play_pause</item>
    </style>
    <style name="PlayerControls.Button.Seek" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">@dimen/player_control_icon_size</item>
        <item name="android:layout_height">@dimen/player_control_icon_size</item>
        <item name="android:background">@drawable/player_control_rewind</item>
        <item name="android:foreground">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center|bottom</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingBottom">@dimen/player_control_seek_padding_bottom</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/player_control_seek_text_size</item>
        <item name="android:textColor">@color/player_control_text</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:contentDescription">@string/player_control_seek</item>
    </style>
    <style name="PlayerControls.Button.FastForward" parent="PlayerControls.Button.Seek">
        <item name="android:background">@drawable/player_control_fastforward</item>
        <item name="android:contentDescription">@string/player_control_fast_forward</item>
    </style>
    <style name="PlayerControls.TimeText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/player_control_time_text_size</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="PlayerControls.TimeText.Position" parent="PlayerControls.TimeText">
        <item name="android:textColor">@color/player_control_text</item>
        <item name="android:text">00:00</item>
    </style>
    <style name="PlayerControls.TimeText.Duration" parent="PlayerControls.TimeText">
        <item name="android:textColor">@color/player_control_muted_text</item>
        <item name="android:text">00:00</item>
    </style>
    <style name="PlayerControls.TimeText.Separator" parent="PlayerControls.TimeText">
        <item name="android:textColor">@color/player_control_muted_text</item>
        <item name="android:text">·</item>
    </style>
</resources>
